{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "reason",
          "evidence",
          "limitations",
          "newUrl",
          "newDescription",
          "blockers",
          "newName"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "keep",
              "update",
              "replace",
              "remove",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "observation"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?://[^\\s]+$"
                },
                "observation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "newUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "newDescription": {
            "type": [
              "string",
              "null"
            ]
          },
          "blockers": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "newName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    }
  }
}
